# =====================================================================
# DevSphere Environment Variables Template
# =====================================================================

# Server & Runtime
PORT=3000
NODE_ENV=development

# Authentication & Sessions
# Must be at least 32 characters long in production
JWT_SECRET=devsphere-supreme-super-secret-key-32-chars-long!

# Supreme Owner Bootstrap
# The primary account that receives exclusive SUPREME_OWNER platform authority
SUPREME_OWNER_EMAIL=supreme@devsphere.io

# AI Coding Assistant (Optional: Intelligent fallback engine active if blank)
GEMINI_API_KEY=

# PostgreSQL / Supabase Connection (Optional: Portable local DAL active if blank)
DATABASE_URL=postgresql://postgres:password@localhost:5432/devsphere
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
